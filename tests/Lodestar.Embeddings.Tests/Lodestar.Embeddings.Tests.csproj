<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Embeddings/Lodestar.Embeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../oracles/**/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- The SentencePiece loader is replayed against the real model file, not a copy of its contents. -->
    <None Include="../oracles/**/*.model" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- merges.txt is a fixture like any other; without this glob the BPE suite cannot find it. -->
    <None Include="../oracles/**/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- Every .npy here was written by numpy itself (#450). They are committed rather than
         generated at test time because the point is to read what numpy produces, and a
         fixture this project builds from its own understanding of the format proves
         nothing about the format. -->
    <None Include="Fixtures/Npy/*.npy" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures/Npy" />
  </ItemGroup>

  <!-- batch_encoding.json is replayed by two suites — the encoder facts here and the
       end-to-end embedding facts in Lodestar.Onnx.Tests — so its reader is linked
       rather than copied, the way the reference gate's engine is. -->
  <ItemGroup>
    <Compile Include="../Shared/BatchCorpus.cs" Link="Fixtures/BatchCorpus.cs" />
  </ItemGroup>

  <!-- The reference gate reads the published pages and the map beside the assembly,
       the way the oracle corpora already are. Added with #235, the package's first
       covered namespace: without this the covered entry would enforce nothing. -->
  <ItemGroup>
    <Compile Include="../Shared/ReferenceDocumentation.cs" Link="Documentation/ReferenceDocumentation.cs" />
    <None Include="../../docs/reference/embeddings/**/*.md" CopyToOutputDirectory="PreserveNewest"
          LinkBase="reference" />
    <None Include="../../docs/wiki-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/**/*.md" Exclude="../../docs/superpowers/**"
          CopyToOutputDirectory="PreserveNewest" LinkBase="docs" />
  </ItemGroup>

</Project>
