<Project>

  <!-- Central Package Management for the test projects under tests/. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <!-- Analyzer only, pinned in the root Directory.Build.props so src/, tests/
         and bench/ cannot drift apart. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="$(LodestarSonarAnalyzerVersion)" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
    <!-- 10.0.12 matches what System.Text.Json 10.0.12 (netstandard2.0) needs; see the
         Lodestar.Extensions.VectorData.NetStandard.Tests reference for why a mirror
         project pins this directly. -->
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12" />
  </ItemGroup>

</Project>
