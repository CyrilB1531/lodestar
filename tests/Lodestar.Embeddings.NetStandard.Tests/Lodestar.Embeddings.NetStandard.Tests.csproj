<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Replays the entire Lodestar.Embeddings.Tests suite against the *netstandard2.0* build of
    the library, instead of the net10.0 one the original project references.

    netstandard2.0 is a contract, not a runtime, so the tests cannot run *on* it.
    They run on net10.0 — identical host — and only the assembly under test
    changes. Without this, the assemblies shipped to .NET Framework, Mono and
    Unity consumers are compile-verified but never executed.

    The test sources are linked, never copied: one suite, two builds.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>Lodestar.Embeddings.NetStandard.Tests</AssemblyName>
    <RootNamespace>Lodestar.Embeddings.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- SetTargetFramework is what pins the reference to the netstandard2.0 build. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Embeddings/Lodestar.Embeddings.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Lodestar.Embeddings.Tests/**/*.cs"
             Exclude="../Lodestar.Embeddings.Tests/bin/**;../Lodestar.Embeddings.Tests/obj/**"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../oracles/**/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- The SentencePiece loader is replayed against the real model file, not a copy of its contents. -->
    <None Include="../oracles/**/*.model" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- merges.txt is a fixture like any other; without this glob the BPE suite cannot find it. -->
    <None Include="../oracles/**/*.txt" CopyToOutputDirectory="PreserveNewest" LinkBase="oracles" />
    <!-- The .npy fixtures live beside the net10.0 suite that owns them, and this project
         compiles the same test sources, so it needs them beside its own assembly too (#450). -->
    <None Include="../Lodestar.Embeddings.Tests/Fixtures/Npy/*.npy" CopyToOutputDirectory="PreserveNewest"
          LinkBase="Fixtures/Npy" />
  </ItemGroup>

  <!-- batch_encoding.json is replayed by two suites — the encoder facts and the
       end-to-end embedding facts in Lodestar.Onnx.Tests — so its reader is linked
       rather than copied, the way the reference gate's engine is. -->
  <ItemGroup>
    <Compile Include="../Shared/BatchCorpus.cs" Link="Fixtures/BatchCorpus.cs" />
  </ItemGroup>

  <!-- The mirror links the same test sources, so it compiles the reference gate too
       and needs the engine, the pages and the map exactly as the net10 project does.
       Without this the linked test file does not compile (#235). -->
  <ItemGroup>
    <Compile Include="../Shared/ReferenceDocumentation.cs" Link="Documentation/ReferenceDocumentation.cs" />
    <None Include="../../docs/reference/embeddings/**/*.md" CopyToOutputDirectory="PreserveNewest"
          LinkBase="reference" />
    <None Include="../../docs/wiki-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/**/*.md" Exclude="../../docs/superpowers/**"
          CopyToOutputDirectory="PreserveNewest" LinkBase="docs" />
  </ItemGroup>

</Project>
