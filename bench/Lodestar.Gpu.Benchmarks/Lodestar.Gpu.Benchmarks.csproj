<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires an optimized, non-debug build to run. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <!--
    Lodestar.Embeddings, Lodestar.Abstractions and Lodestar.Text hold the baselines; the package
    itself reaches only Lodestar.Abstractions. src/Lodestar.Gpu/performance.md's gate prices a
    kernel against this repository's own CPU path in the same process.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Gpu/Lodestar.Gpu.csproj" />
    <ProjectReference Include="../../src/Lodestar.Embeddings/Lodestar.Embeddings.csproj" />
    <ProjectReference Include="../../src/Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
    <ProjectReference Include="../../src/Lodestar.Text/Lodestar.Text.csproj" />
  </ItemGroup>

</Project>
