<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires an optimized, non-debug build to run. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- The incumbent: archived November 2020, last published October 2017, and
         still the only .NET library that carried these tests. -->
    <PackageReference Include="Accord.Statistics" Version="3.8.0" />
    <!-- bench/ only: its Cortex.ML edge bars it from src/ under decision 0076
         (tools/check_nuspec_dependencies.py enforces that boundary, not this file). -->
    <PackageReference Include="Cortex.TimeSeries" Version="1.1.0" />
    <!-- The incumbent for the weighted regression (#782) and for GLS (#771): MIT, maintained, and the one numerics
         library src/ already reaches through Lodestar.Extensions.MathNet. It exports no GLS, so GlsBenchmarks
         writes the one its users would. -->
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <!-- The incumbent #756 measures: MS-PL, netstandard2.0, published 2025-07-14, and the only
         maintained .NET library carrying these eight test families. Read under decision 0074's
         protocol in decision 0129; bench/ only, like every incumbent here. -->
    <PackageReference Include="Meta.Numerics" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Transitive through Cortex.ML, pulled in by Cortex.TimeSeries above. Neither
         advisory reaches code this benchmark calls (AngleSharp's HTML parser, Snappier's
         compression codec), and nothing under src/ ever references either package. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pggp-6c3x-2xmx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Stats/Lodestar.Stats.csproj" />
    <ProjectReference Include="../../src/Lodestar.Stats.Regression/Lodestar.Stats.Regression.csproj" />
    <ProjectReference Include="../../src/Lodestar.Stats.TimeSeries/Lodestar.Stats.TimeSeries.csproj" />
  </ItemGroup>

</Project>
