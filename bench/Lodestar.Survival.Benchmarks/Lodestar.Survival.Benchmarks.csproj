<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires an optimized, non-debug build to run. -->
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
    <!-- No incumbent package here to compare against: the #427 reading found zero
         NuGet results for survival analysis, which decision 0099 records. These
         measure the three estimators against each other and against input size. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Lodestar.Survival/Lodestar.Survival.csproj" />
  </ItemGroup>

</Project>
