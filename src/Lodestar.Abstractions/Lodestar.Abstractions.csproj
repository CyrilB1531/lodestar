<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarAbstractionsVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Abstractions</RootNamespace>
    <!-- No code beyond CsrMatrix and what the moved data types call (decision 0003, epoch 3), so of
         the shared helpers only four: ValueEquality for the data types' structural equality,
         ElementWise's AddScaled and Guard for CsrMatrix's products and constructor (#1282, #1417), and
         TableLength for its dense and product bounds (#1614). -->
    <LodestarIncludesSharedHelpers>false</LodestarIncludesSharedHelpers>
    <LodestarIncludesValueEquality>true</LodestarIncludesValueEquality>
    <LodestarIncludesGuard>true</LodestarIncludesGuard>
    <LodestarIncludesTableLength>true</LodestarIncludesTableLength>
    <LodestarIncludesElementWise>true</LodestarIncludesElementWise>
    <LodestarElementWiseAddScaledOnly>true</LodestarElementWiseAddScaledOnly>

    <PackageId>Lodestar.Abstractions</PackageId>
    <Description>The types Lodestar's packages share: a compressed sparse row matrix with the vector and dense-block products a decomposition needs, and the public options, results and enums the packages declare that carry no logic. No dependencies, no I/O, nothing to configure.</Description>
    <PackageTags>sparse;csr;matrix;linear-algebra;lodestar</PackageTags>
  </PropertyGroup>

</Project>
