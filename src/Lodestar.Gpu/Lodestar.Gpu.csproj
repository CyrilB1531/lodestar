<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <!--
      net10.0 and netstandard2.1, the only package here without netstandard2.0.
      ILGPU publishes no netstandard2.0 asset, so that target is absent upstream
      rather than a gap a polyfill could close, and no polyfill produces an
      accelerator; it does publish netstandard2.1, the floor taken here (decision 0003).
    -->
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <Version>$(LodestarGpuVersion)</Version>
    <RootNamespace>Lodestar.Gpu</RootNamespace>

    <PackageId>Lodestar.Gpu</PackageId>
    <Description>GPU kernels for Lodestar over ILGPU, on device-resident data: cosine similarity and top-k over an embedding matrix swept by a batch of queries, a sparse-dense matrix product, bit-parallel edit distance, and MinHash signatures over tokenized text. Additive — no Lodestar package depends on this one, so the SIMD path stays complete on every target framework.</Description>
    <PackageTags>gpu;gpgpu;ilgpu;cuda;opencl;cosine-similarity;top-k;knn;embeddings;lodestar</PackageTags>
    <LodestarIncludesMinHash>true</LodestarIncludesMinHash>
  </PropertyGroup>

  <!-- The dependency this package exists for. A core package carries none, so
       ILGPU earns its own satellite (decision 0003). NCSA-licensed, read from
       LICENSE.txt inside the package because no SPDX expression is declared. -->
  <ItemGroup>
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <!--
    One Lodestar edge, to Lodestar.Abstractions, below. None inwards, which decision 0003
    forbids, and no other outwards: kernels take spans and dimensions, so a caller holding
    another package's type adapts it rather than this package flooring on that sibling.
  -->

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Gpu.Tests" />
    <InternalsVisibleTo Include="Lodestar.Gpu.NetStandard.Tests" />
  </ItemGroup>

  <!-- MinHashScheme, forwarded to Lodestar.Abstractions (decision 0003, #1142), and SearchResult,
       which TiledCosineTopK.Search returns (#1214). The floor is pinned in
       src/Directory.Packages.props, like every other src/ reference. -->
  <ItemGroup>
    <PackageReference Include="Lodestar.Abstractions" />
  </ItemGroup>

</Project>
