<Project>

  <!--
    Lodestar.Preprocessing owns its version here, independently of the other
    packages (see docs/decisions/0012-per-package-versioning.md).

    0.1.0 is the published version. The number moves only when a release is cut
    (CONTRIBUTING.md, Releasing), never in the pull request that adds the work.
    It depends on Lodestar.Stats and Lodestar.Abstractions (decisions 0138 and
    0139), whose floors live in src/Directory.Packages.props.
  -->
  <PropertyGroup>
    <LodestarPreprocessingVersion>0.1.0</LodestarPreprocessingVersion>
  </PropertyGroup>

</Project>
