<Project>

  <!--
    Lodestar.Preprocessing owns its version here, independently of the other
    packages (see docs/decisions/0012-per-package-versioning.md).

    0.5.0 adds the incremental fits and the sparse overloads (#765), after the
    encoders of 0.4.0, the scalers of 0.3.0 and the splitters of 0.2.0.
    Like Lodestar.Metrics and
    Lodestar.Conformal it creates no inter-package edge — nothing depends on it
    and it depends on nothing — so it releases on its own schedule rather than
    matching the others.
  -->
  <PropertyGroup>
    <LodestarPreprocessingVersion>0.5.0</LodestarPreprocessingVersion>
  </PropertyGroup>

</Project>
