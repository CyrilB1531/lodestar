<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarPreprocessingVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Preprocessing</RootNamespace>

    <PackageId>Lodestar.Preprocessing</PackageId>
    <Description>Feature preprocessing for .NET at scikit-learn parity: fit a scaler on arrays and transform arrays, with the fitted statistics readable. Spans in, arrays out — no IDataView, no pipeline object, and nothing to adopt beyond the call.</Description>
    <PackageTags>preprocessing;standardscaler;scaling;normalization;scikit-learn;feature-engineering;lodestar</PackageTags>
  </PropertyGroup>

  <!--
    Three edges, all to core packages: Lodestar.Stats for the normal quantile RobustScaler's
    unit_variance divides by (decision 0003), Lodestar.Abstractions for the CsrMatrix the sparse
    overloads take (decision 0003, which applies 0138's precedent rather than reopening it), and
    Lodestar.Cluster for the one-dimensional k-means KBinsDiscretizer's kmeans strategy runs
    (#1122): an edge rather than a second Lloyd's algorithm written here, which is what #763
    decided. Each is a PackageReference against its published floor, like every other src/ edge
    (decision 0001), with the usual developer-loop opt-in, never set in CI:

        export LodestarUseProjectRefs=true
  -->
  <ItemGroup Condition="'$(LodestarUseProjectRefs)' == 'true'">
    <ProjectReference Include="../Lodestar.Stats/Lodestar.Stats.csproj" />
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
    <ProjectReference Include="../Lodestar.Cluster/Lodestar.Cluster.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(LodestarUseProjectRefs)' != 'true'">
    <PackageReference Include="Lodestar.Stats" />
    <PackageReference Include="Lodestar.Abstractions" />
    <PackageReference Include="Lodestar.Cluster" />
  </ItemGroup>

  <!-- Loud on purpose: a local build that silently differed from the shipped one
       is the failure mode this whole arrangement is designed to avoid. -->
  <Target Name="WarnOnLocalProjectRefs" BeforeTargets="Build"
          Condition="'$(LodestarUseProjectRefs)' == 'true'">
    <Message Importance="high"
             Text="Lodestar.Preprocessing: LodestarUseProjectRefs=true — referencing Lodestar.Stats, Lodestar.Abstractions and Lodestar.Cluster by project, not by package. This is the developer loop, not what ships." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Preprocessing.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Preprocessing.NetStandard.Tests" />
  </ItemGroup>

</Project>
