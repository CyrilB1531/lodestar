<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarConformalVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Conformal</RootNamespace>

    <PackageId>Lodestar.Conformal</PackageId>
    <Description>Conformal prediction for .NET at MAPIE parity — split, CV+ and Jackknife+: turn a point prediction into an interval, or a class into a prediction set, with a finite-sample coverage guarantee. Post-hoc over scores and labels — no model, no training loop, no dependencies. The guarantee assumes exchangeable calibration and test data; it does not hold for time series.</Description>
    <PackageTags>conformal;conformal-prediction;uncertainty;prediction-interval;coverage;mapie;lodestar</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Conformal.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Conformal.NetStandard.Tests" />
  </ItemGroup>

  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). The
       cross-conformal enums it adds live there too (#1159), so it reaches that project
       unconditionally until the next Lodestar.Abstractions is on nuget.org; packing turns the
       reference into a dependency on that version. The release swaps it back for a
       PackageReference on the published floor and drops its exception in ci.yml's
       "src/ ships PackageReference only" step. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

</Project>
