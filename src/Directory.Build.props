<Project>

  <!-- Chain to the repository-root Directory.Build.props (MSBuild otherwise stops
       at the nearest one). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Compile-time polyfills (records/init, Index/Range, nullable attrs…) so the
       netstandard2.0 target builds. PrivateAssets=all: no runtime dependency. -->
  <ItemGroup>
    <PackageReference Include="PolySharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- The rules that gate the pull request, running in the build that writes the
       code. PrivateAssets=all keeps the analyzer out of every published .nuspec,
       and tools/check_nuspec_dependencies.py asserts it stays out. See
       CLAUDE.md's analyzer section. -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <!-- Shared internal helpers, compiled into every library that asks for them.
       Lodestar.Abstractions opts out: it carries no code beyond CsrMatrix and what its
       data types call (decision 0003, epoch 3), so it takes ValueEquality, Guard, ElementWise and
       TableLength one by one below. -->
  <ItemGroup Condition="'$(LodestarIncludesSharedHelpers)' != 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/GlobalUsings.cs" Link="Internal/GlobalUsings.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Guard.cs" Link="Internal/Guard.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Guard.Disposal.cs" Link="Internal/Guard.Disposal.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/MapEquality.cs" Link="Internal/MapEquality.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RegexDefaults.cs" Link="Internal/RegexDefaults.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/StringCompat.cs" Link="Internal/StringCompat.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TableLength.cs" Link="Internal/TableLength.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ValueEquality.cs" Link="Internal/ValueEquality.cs" />
  </ItemGroup>

  <!-- The structural equality the data types in Lodestar.Abstractions call, for the one library
       that opts out of the helpers above. It grants no InternalsVisibleTo, so a copy compiled
       there and one compiled into a consumer cannot meet as CS0436, which #440 once hit. -->
  <ItemGroup Condition="'$(LodestarIncludesValueEquality)' == 'true' and '$(LodestarIncludesSharedHelpers)' == 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ValueEquality.cs" Link="Internal/ValueEquality.cs" />
  </ItemGroup>

  <!-- The global using the shared helpers are reached through, once for a library that opted out
       and takes any of them one by one. -->
  <ItemGroup Condition="'$(LodestarIncludesSharedHelpers)' == 'false' and ('$(LodestarIncludesValueEquality)' == 'true' or '$(LodestarIncludesGuard)' == 'true' or '$(LodestarIncludesTableLength)' == 'true')">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/GlobalUsings.cs" Link="Internal/GlobalUsings.cs" />
  </ItemGroup>

  <!-- The argument guards, for a library that opts out of the helpers above: CsrMatrix's constructor
       and products call them in Lodestar.Abstractions (#1282). The disposal guard, which that
       package does not call, lives in Guard.Disposal.cs and stays out (#1490). -->
  <ItemGroup Condition="'$(LodestarIncludesGuard)' == 'true' and '$(LodestarIncludesSharedHelpers)' == 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Guard.cs" Link="Internal/Guard.cs" />
  </ItemGroup>

  <!-- The runtime's largest array, for a library that opts out of the helpers above: CsrMatrix's
       dense and product bounds in Lodestar.Abstractions, which runtimes before .NET 6 cap lower (#1614). -->
  <ItemGroup Condition="'$(LodestarIncludesTableLength)' == 'true' and '$(LodestarIncludesSharedHelpers)' == 'false'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TableLength.cs" Link="Internal/TableLength.cs" />
  </ItemGroup>

  <!-- mean_variance_axis over a sparse matrix, compiled into the two libraries that read a column's
       variance off one: Lodestar.Decomposition for TruncatedSvd's total variance, Lodestar.Preprocessing
       for StandardScaler (#1228). Neither reaches the other's internals across a published floor. -->
  <ItemGroup Condition="'$(LodestarIncludesSparseMoments)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/SparseMoments.cs" Link="Internal/SparseMoments.cs" />
  </ItemGroup>

  <!-- The affine-32 coefficient refusal, compiled into the two libraries that sketch.
       Lodestar.Gpu carries no edge to any Lodestar package and Lodestar.Text is where the
       CPU path lives, so shared source is the only way the two hold one copy (#645). -->
  <ItemGroup Condition="'$(LodestarIncludesMinHash)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/MinHashCoefficients.cs"
             Link="Internal/MinHashCoefficients.cs" />
  </ItemGroup>

  <!-- The Householder reflection and its four-lane inner product, compiled into the two libraries
       that fit by reflections. Lodestar.Stats.TimeSeries reuses one QR across a lag search and must
       add the terms in Lodestar.Stats.Regression's order, whose kernel is internal there (#843). -->
  <ItemGroup Condition="'$(LodestarIncludesReflections)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Reflections.cs" Link="Internal/Reflections.cs" />
  </ItemGroup>

  <!-- The element-wise dense updates, compiled into the four libraries whose kernels make them.
       Lodestar.Abstractions opts out of the helpers above, and no two of these can reach each other's
       internals across a published floor, so shared source keeps one copy (#845, #978). This
       file carries AddScaled alone; the kernels' rotations follow below (#1291, #1417). -->
  <ItemGroup Condition="'$(LodestarIncludesElementWise)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ElementWise.cs" Link="Internal/ElementWise.cs" />
  </ItemGroup>

  <!-- The rotations and subtraction only the dense kernels call. Lodestar.Abstractions, whose products
       call AddScaled alone, opts out, so no code it never runs is compiled into it (#1417). -->
  <ItemGroup Condition="'$(LodestarIncludesElementWise)' == 'true' and '$(LodestarElementWiseAddScaledOnly)' != 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ElementWise.Kernels.cs" Link="Internal/ElementWise.Kernels.cs" />
  </ItemGroup>

  <!-- The one-sided Jacobi spectrum, compiled into the three libraries that read singular values.
       Lodestar.Decomposition factors with it; Lodestar.Stats.Regression and Lodestar.Stats.TimeSeries
       measure a triangular factor's rank and condition with it, and neither can reach the other's
       internals across a published floor, so shared source keeps one copy (#978). -->
  <ItemGroup Condition="'$(LodestarIncludesJacobiSpectrum)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/JacobiSpectrum.cs" Link="Internal/JacobiSpectrum.cs" />
  </ItemGroup>

  <!-- The rank bracket over a triangularized design, compiled into the two libraries that refuse on it.
       Lodestar.Stats.Regression and Lodestar.Stats.TimeSeries must refuse the same designs and cannot
       reach each other's internals across a published floor, so shared source keeps one copy (#978). -->
  <ItemGroup Condition="'$(LodestarIncludesRankBracket)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/RankBracket.cs" Link="Internal/RankBracket.cs" />
  </ItemGroup>

  <!-- Python's string order, by code point rather than by UTF-16 unit, compiled into the libraries
       that sort text the way their references sort a str (#1264, #1254). -->
  <ItemGroup Condition="'$(LodestarIncludesCodePointOrder)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CodePointOrder.cs" Link="Internal/CodePointOrder.cs" />
  </ItemGroup>

  <!-- numpy's linspace, percentiles and medians, compiled into the libraries that must land where
       numpy does: Lodestar.Metrics for calibration_curve (#1204), Lodestar.Preprocessing for
       KBinsDiscretizer, RobustScaler, QuantileTransformer and SimpleImputer (#1226, #1230, #1237). -->
  <ItemGroup Condition="'$(LodestarIncludesNumpyGrid)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/NumpyGrid.cs" Link="Internal/NumpyGrid.cs" />
  </ItemGroup>

  <!-- log1p and expm1 kept accurate near zero, one implementation for the libraries that need them:
       Lodestar.Metrics, Lodestar.Preprocessing, Lodestar.Stats and Lodestar.Survival (#1230). -->
  <ItemGroup Condition="'$(LodestarIncludesNearZero)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/NearZero.cs" Link="Internal/NearZero.cs" />
  </ItemGroup>

  <!-- Temme's uniform expansion's coefficients, one table for the incomplete gamma in Lodestar.Stats and the
       generalized gamma quantile in Lodestar.Survival (#1729). -->
  <ItemGroup Condition="'$(LodestarIncludesTemmeSeries)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/TemmeSeries.cs" Link="Internal/TemmeSeries.cs" />
  </ItemGroup>

  <!-- A confidence interval's normal and Student multipliers, one copy for Lodestar.Stats, Lodestar.Stats.Regression,
       Lodestar.Stats.TimeSeries and Lodestar.Survival (#1729). -->
  <ItemGroup Condition="'$(LodestarIncludesCriticalValue)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/CriticalValue.cs" Link="Internal/CriticalValue.cs" />
  </ItemGroup>

  <!-- Mills' ratio's asymptotic series, for the normal tail in Lodestar.Stats and the generalized gamma quantile in
       Lodestar.Survival (#1729). -->
  <ItemGroup Condition="'$(LodestarIncludesMillsSeries)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/MillsSeries.cs" Link="Internal/MillsSeries.cs" />
  </ItemGroup>

  <!-- A product's exact rounding, a fused multiply-add on net10.0 and Dekker's split product on
       netstandard2.0: Lodestar.Stats' incomplete beta takes its shape exponent with it, and its normal
       tail the exact exponent past z = 6 (#1690). -->
  <ItemGroup Condition="'$(LodestarIncludesExactProduct)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ExactProduct.cs" Link="Internal/ExactProduct.cs" />
  </ItemGroup>

  <!-- Persistence plumbing, compiled only into the libraries that ship artifacts
       (Lodestar.Text, Lodestar.Embeddings). It needs System.Text.Json, which those
       two opt into individually — Lodestar.Fuzzy stays dependency-free.
       See docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md. -->
  <ItemGroup Condition="'$(LodestarIncludesPersistence)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/ArtifactHeader.cs" Link="Internal/Persistence/ArtifactHeader.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/ArtifactLimits.cs" Link="Internal/Persistence/ArtifactLimits.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/JsonArtifact.cs" Link="Internal/Persistence/JsonArtifact.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/ArtifactIo.cs" Link="Internal/Persistence/ArtifactIo.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/Base64Numbers.cs" Link="Internal/Persistence/Base64Numbers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/Buffers.cs" Link="Internal/Persistence/Buffers.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/StreamFill.cs" Link="Internal/Persistence/StreamFill.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Shared/Persistence/SpillBuffer.cs" Link="Internal/Persistence/SpillBuffer.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LodestarIncludesPersistence)' == 'true' AND '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <!-- Span, Memory, ArrayPool and Vector<T> are in-box on net10 but need these
       packages on netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Numerics.Vectors" />
  </ItemGroup>

</Project>
