<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarEmbeddingsVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Embeddings</RootNamespace>
    <!-- Pulls in the shared persistence plumbing (and System.Text.Json on ns2.0). -->
    <LodestarIncludesPersistence>true</LodestarIncludesPersistence>

    <PackageId>Lodestar.Embeddings</PackageId>
    <Description>Sub-word tokenizers (WordPiece, SentencePiece, BPE and byte-level BPE), batch encoding, pooling and SIMD kNN search for .NET. No external dependency: ONNX inference lives in Lodestar.Onnx, so a caller who only tokenizes never restores a native runtime.</Description>
    <PackageTags>embeddings;tokenizer;wordpiece;sentencepiece;bpe;semantic-search;knn;nlp;lodestar</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Embeddings.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Embeddings.NetStandard.Tests" />
  </ItemGroup>

  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). SentencePiece's
       hash reads every NaN alike since #1285, so this reaches that project unconditionally until the next
       Lodestar.Abstractions is on nuget.org; packing turns the reference into a dependency on that
       version. The release swaps it back for a PackageReference and drops its exception in ci.yml's
       "src/ ships PackageReference only" step. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

</Project>
