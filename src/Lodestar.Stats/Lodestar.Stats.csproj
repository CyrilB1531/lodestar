<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <LodestarIncludesCriticalValue>true</LodestarIncludesCriticalValue>
    <LodestarIncludesNearZero>true</LodestarIncludesNearZero>
    <LodestarIncludesTemmeSeries>true</LodestarIncludesTemmeSeries>
    <LodestarIncludesTrigamma>true</LodestarIncludesTrigamma>
    <LodestarIncludesMillsSeries>true</LodestarIncludesMillsSeries>
    <LodestarIncludesExactProduct>true</LodestarIncludesExactProduct>
    <Version>$(LodestarStatsVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Stats</RootNamespace>

    <PackageId>Lodestar.Stats</PackageId>
    <Description>Classical hypothesis tests for .NET at scipy.stats parity: Student and Welch t, Mann-Whitney U, Wilcoxon signed-rank, chi-square, Fisher exact, Kolmogorov-Smirnov, one-way ANOVA, Kruskal-Wallis, Shapiro-Wilk, and Bonferroni / Benjamini-Hochberg / Benjamini-Yekutieli corrections. Arrays in, statistic and p-value out. No model, no training loop, and no dependency beyond Lodestar.Abstractions, which holds its options and results.</Description>
    <PackageTags>statistics;hypothesis-test;p-value;t-test;anova;mann-whitney;wilcoxon;chi-square;fisher-exact;shapiro-wilk;scipy;lodestar</PackageTags>
  </PropertyGroup>

  <!--
    The fifteen data types this package forwards to Lodestar.Abstractions: the options enums and
    plain results of 0.5.0 (decision 0003, #1142), the k-sample variant and the correlation
    matrix (#1162).

    Siblings by project until the packages are on nuget.org (#1739): pack turns each into a
    dependency on that project's declared version, which check_nuspec_dependencies.py asserts.
  -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Stats.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Stats.NetStandard.Tests" />
  </ItemGroup>

</Project>
