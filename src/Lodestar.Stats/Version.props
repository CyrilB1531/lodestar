<Project>

  <!--
    Lodestar.Stats owns its version here, independently of the other packages
    (see docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md).

    0.1.0 is this package's first release. It releases on its own schedule
    rather than matching the others: it depends on Lodestar.Abstractions alone,
    and Lodestar.Stats.Regression, Lodestar.Stats.TimeSeries, Lodestar.Survival
    and Lodestar.Preprocessing depend on it, each through a published floor
    (tools/check_nuspec_dependencies.py holds the edges).
  -->
  <PropertyGroup>
    <LodestarStatsVersion>0.5.1</LodestarStatsVersion>
  </PropertyGroup>

</Project>
