<Project>

  <!--
    Lodestar.Survival owns its version here, independently of the other packages
    (see docs/decisions/0012-per-package-versioning.md).

    0.1.0 is this package's first release. Its one inter-package edge is to
    Lodestar.Stats, for the chi-squared tail the log-rank test reports; that floor
    lives in src/Directory.Packages.props and is deliberately decoupled from this
    number.
  -->
  <PropertyGroup>
    <LodestarSurvivalVersion>0.1.0</LodestarSurvivalVersion>
  </PropertyGroup>

</Project>
