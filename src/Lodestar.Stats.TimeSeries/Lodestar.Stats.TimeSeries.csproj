<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarStatsTimeSeriesVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Stats.TimeSeries</RootNamespace>

    <PackageId>Lodestar.Stats.TimeSeries</PackageId>
    <Description>Time-series diagnostics for .NET, at statsmodels parity: the autocorrelation and partial autocorrelation functions with their bands, the Ljung-Box test, the augmented Dickey-Fuller test with MacKinnon p-values, KPSS, and classical seasonal decomposition. Spans in, numbers out, and no dependencies outside Lodestar.</Description>
    <PackageTags>time-series;stationarity;unit-root;dickey-fuller;adf;kpss;autocorrelation;ljung-box;seasonal-decomposition;statistics;statsmodels;lodestar</PackageTags>
    <LodestarIncludesReflections>true</LodestarIncludesReflections>
    <LodestarIncludesElementWise>true</LodestarIncludesElementWise>
    <LodestarIncludesJacobiSpectrum>true</LodestarIncludesJacobiSpectrum>
    <LodestarIncludesRankBracket>true</LodestarIncludesRankBracket>
  </PropertyGroup>

  <!--
    Two edges, both to core packages: Lodestar.Stats for the tails, and Lodestar.Stats.Regression
    for the fits the augmented Dickey-Fuller test runs per candidate lag. The second is the reason
    this is a package at all.

    Both are ProjectReferences for now: Lodestar.Stats.Regression for the reason below, and
    Lodestar.Stats for the #1142 wave, in the block after it.
  -->

  <!--
    TODO(#671, at the Lodestar.Stats.Regression 0.2.0 release): replace this ProjectReference with
    <PackageReference Include="Lodestar.Stats.Regression" /> and a PackageVersion of 0.2.0 in
    src/Directory.Packages.props, then drop the exception in ci.yml's "src/ ships PackageReference
    only" step and restore the FLOORS row in tools/check_version_floor.py.

    Why a ProjectReference, unconditionally, and the one src/ carries: the published 0.1.0 declares
    OlsOptions.WithIntercept with a plain setter, and 0.2.0 made OlsOptions a record with an init
    setter. The two are binary-incompatible, so this package built against 0.1.0 throws
    MissingMethodException wherever 0.2.0 is loaded, measured in the benchmark project. Packing
    turns the reference into a dependency on the referenced project's own version, so the nuspec
    already declares the final floor, Lodestar.Stats.Regression 0.2.0.
  -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Stats.Regression/Lodestar.Stats.Regression.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Stats.TimeSeries.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Stats.TimeSeries.NetStandard.Tests" />
  </ItemGroup>

  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). A
       ProjectReference, unconditionally, until Lodestar.Abstractions 0.2.0 is on nuget.org: the
       types leave this assembly in the same commit they arrive in that one, and packing turns
       the reference into a dependency on 0.2.0. The release swaps it for a PackageReference on
       the published floor and drops the exception in ci.yml's "src/ ships PackageReference
       only" step.

       Lodestar.Stats is referenced the same way for the same wave: the Lodestar.Stats.Regression
       project above brings the working tree's Lodestar.Stats, and a published floor beside it would
       be the same id at two versions. The release restores the published floors, and the
       LodestarUseProjectRefs developer loop with them. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
    <ProjectReference Include="../Lodestar.Stats/Lodestar.Stats.csproj" />
  </ItemGroup>

</Project>
