<Project>

  <!--
    Lodestar.Cluster owns its version here, independently of the other packages
    (see docs/decisions/0012-per-package-versioning.md).

    0.1.0 is the published version. The number moves only when a release is cut
    (CONTRIBUTING.md, Releasing), never in the pull request that adds the work.
    It creates no inter-package edge, so it releases on its own schedule.
  -->
  <PropertyGroup>
    <LodestarClusterVersion>0.1.0</LodestarClusterVersion>
  </PropertyGroup>

</Project>
