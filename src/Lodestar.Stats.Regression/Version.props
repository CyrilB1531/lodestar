<Project>

  <!--
    Lodestar.Stats.Regression owns its version here, independently of the other
    packages (see docs/decisions/0012-per-package-versioning.md).

    0.1.0 is this package's first release. It carries two inter-package edges, to
    Lodestar.Stats for the Student and Fisher tails and to Lodestar.Decomposition
    for the Householder QR; both floors live in src/Directory.Packages.props and
    are deliberately decoupled from this number.
  -->
  <PropertyGroup>
    <LodestarStatsRegressionVersion>0.1.0</LodestarStatsRegressionVersion>
  </PropertyGroup>

</Project>
