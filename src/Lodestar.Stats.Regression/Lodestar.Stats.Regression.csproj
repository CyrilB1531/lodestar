<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarStatsRegressionVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Stats.Regression</RootNamespace>

    <PackageId>Lodestar.Stats.Regression</PackageId>
    <Description>Ordinary, weighted and generalized least squares with inference for .NET, at statsmodels parity: standard errors, t statistics, p-values, confidence intervals, R-squared and its adjusted form, the overall F test and a variance inflation factor per regressor. Solved through a Householder QR rather than the normal equations. Spans in, one summary out, and no dependencies outside Lodestar.</Description>
    <PackageTags>regression;ols;wls;gls;least-squares;inference;p-value;statistics;statsmodels;vif;lodestar</PackageTags>
    <LodestarIncludesReflections>true</LodestarIncludesReflections>
    <LodestarIncludesElementWise>true</LodestarIncludesElementWise>
    <LodestarIncludesJacobiSpectrum>true</LodestarIncludesJacobiSpectrum>
    <LodestarIncludesRankBracket>true</LodestarIncludesRankBracket>
  </PropertyGroup>

  <!--
    Two edges, both to core packages and both real: the Student and Fisher tails that
    turn an estimate into a p-value, and the thin QR that keeps a near-collinear design
    from losing digits the normal equations would square away. Decision 0003 published
    exactly those four members for this package and no others.

    PackageReference against the published floors, like every other src/ edge, so the
    build graph is the graph consumers see (decision 0001). The opt-in below exists only
    so that editing two packages in one branch does not need a pack-and-restore per edit:

        export LodestarUseProjectRefs=true

    It is never set in CI, and the packed .nuspec is asserted there.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Stats.Regression.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Stats.Regression.NetStandard.Tests" />
  </ItemGroup>

  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). A
       ProjectReference, unconditionally, until Lodestar.Abstractions 0.2.0 is on nuget.org: the
       types leave this assembly in the same commit they arrive in that one, and packing turns
       the reference into a dependency on 0.2.0. The release swaps it for a PackageReference on
       the published floor and drops the exception in ci.yml's "src/ ships PackageReference
       only" step.

       Lodestar.Stats and Lodestar.Decomposition are referenced the same way for the same wave:
       this package names Alternative, which the published Lodestar.Stats 0.4.0 declares and
       Lodestar.Abstractions 0.2.0 now does too, so the two together would be CS0433. The release
       restores their published floors, and the LodestarUseProjectRefs developer loop with them. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
    <ProjectReference Include="../Lodestar.Stats/Lodestar.Stats.csproj" />
    <ProjectReference Include="../Lodestar.Decomposition/Lodestar.Decomposition.csproj" />
  </ItemGroup>

</Project>
