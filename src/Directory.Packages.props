<Project>

  <!-- Central Package Management for the shipped libraries under src/. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Every Lodestar package here is a floor on a sibling, one per edge CLAUDE.md lists. Since
    #1142 each package's public data types live in Lodestar.Abstractions 0.2.0 and are forwarded
    from the package that declared them, so a floor on a release from before that move beside
    Lodestar.Abstractions 0.2.0 declares the same type twice (CS0433): every sibling that moved
    types is floored at the release that forwards them, published on 2026-09-24.
    Lodestar.Stats.Regression is floored at 0.2.0 for a second reason, the binary break in
    OlsOptions (#671). Lodestar.Onnx stays at 0.1.0, which moved no type. Each number is a
    deliberately chosen *floor* — the minimum a consumer is required to take — and is therefore
    written in full rather than tracking the sibling's $(Lodestar*Version).

    Keeping it decoupled is what makes `git clone && dotnet build` work with no
    pack step: the floor always names a version that is already on nuget.org.
    Raise one only when the dependent actually needs newer API, and publish the
    dependency first when you do. See
    docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md.
  -->
  <ItemGroup>
    <PackageVersion Include="Lodestar.Abstractions" Version="0.2.0" />
    <PackageVersion Include="Lodestar.Cluster" Version="0.2.0" />
    <PackageVersion Include="Lodestar.Decomposition" Version="0.3.0" />
    <!-- Also never below 0.6.0: 0.5.0 still declares Microsoft.ML.OnnxRuntime, which 0.6.0
         moved to Lodestar.Onnx, and Extensions.VectorData must not restore it. -->
    <PackageVersion Include="Lodestar.Embeddings" Version="0.8.0" />
    <PackageVersion Include="Lodestar.Onnx" Version="0.1.0" />
    <PackageVersion Include="Lodestar.Stats" Version="0.5.0" />
    <PackageVersion Include="Lodestar.Stats.Regression" Version="0.2.0" />
    <PackageVersion Include="Lodestar.Text" Version="0.7.0" />
    <!-- 1.5.3 (2025-07-12) is the newest, and its newest asset is net7.0.
         Carried by Lodestar.Gpu alone, which is net10.0 only because ILGPU
         publishes no netstandard2.0 asset at all (decision 0003). -->
    <PackageVersion Include="ILGPU" Version="1.5.3" />
    <!-- Abstractions only: the interfaces a consumer already has, and no
         implementation. Carried by Lodestar.Extensions.AI alone, which is the
         satellite it earns under decision 0003. -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.30.0" />
    <!-- The dependency Lodestar.Extensions.VectorData exists for. Its own single
         dependency is Microsoft.Extensions.AI.Abstractions at this same 10.10.0,
         so the two satellites agree without a range to reconcile. -->
    <PackageVersion Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.10.0" />
    <!-- 5.0.0 (2022-04-03) is still the only stable release; carried by
         Lodestar.Extensions.MathNet alone, which converts to its types rather
         than computing with them (decision 0003). -->
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="PolySharp" Version="1.16.0" />
    <!-- Analyzer only, pinned in the root Directory.Build.props so src/, tests/
         and bench/ cannot drift apart. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="$(LodestarSonarAnalyzerVersion)" />
    <!-- 4.6.3 is the floor System.Text.Json 10.0.x asks for on netstandard2.0;
         pinning lower makes the restore a downgrade, which is an error here. -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.6.1" />
    <!-- In-box on net10; referenced only for the netstandard2.0 target. The one
         deliberate runtime dependency of the persistence layer — see
         docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

</Project>
