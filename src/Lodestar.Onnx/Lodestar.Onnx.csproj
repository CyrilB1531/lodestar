<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarOnnxVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Onnx</RootNamespace>

    <PackageId>Lodestar.Onnx</PackageId>
    <Description>ONNX Runtime inference for Lodestar: runs a transformer encoder exported to ONNX and pools its token outputs into a sentence embedding. Split out of Lodestar.Embeddings so the tokenizers, the pooling and the kNN index reach a caller who does not want a native runtime.</Description>
    <PackageTags>onnx;onnxruntime;embeddings;inference;sentence-embedding;transformer;nlp;lodestar</PackageTags>
  </PropertyGroup>

  <!-- The one external dependency of this package, and the reason it exists: a core
       package carries none, so ONNX Runtime gets a satellite of its own (#1528). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <!--
    OnnxTextEmbedder feeds a session with Lodestar.Embeddings' tokenizers, encoding options and
    pooling, so the dependency is real and permanent.

    Siblings by project until the packages are on nuget.org (#1739): pack turns each into a
    dependency on that project's declared version, which check_nuspec_dependencies.py asserts.
  -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Embeddings/Lodestar.Embeddings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Onnx.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Onnx.NetStandard.Tests" />
  </ItemGroup>

</Project>
