<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarExtensionsMathNetVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Extensions.MathNet</RootNamespace>

    <PackageId>Lodestar.Extensions.MathNet</PackageId>
    <Description>Math.NET Numerics interoperability for Lodestar: converts a CsrMatrix to and from Math.NET's sparse matrix by copying the compressed-row arrays both sides store, so a caller already holding Math.NET types can reach Lodestar.Decomposition and the sparse vectorizers without rebuilding a matrix cell by cell.</Description>
    <PackageTags>mathnet;mathnet-numerics;sparse-matrix;csr;interop;linear-algebra;lodestar</PackageTags>
  </PropertyGroup>

  <!-- The dependency this package exists for, and the reason it sits in the interop
       tier: a core package carries none, and Lodestar.Decomposition refused this very
       library for its own kernels on freshness grounds. Converting to a caller's
       types is not computing with them — decision 0003. -->
  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" />
  </ItemGroup>

  <!--
    One Lodestar edge: CsrMatrix is the type being converted.

    Siblings by project until the packages are on nuget.org (#1739): pack turns each into a
    dependency on that project's declared version, which check_nuspec_dependencies.py asserts.
  -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Extensions.MathNet.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Extensions.MathNet.NetStandard.Tests" />
  </ItemGroup>

</Project>
