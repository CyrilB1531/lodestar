<Project>

  <!--
    Lodestar.Extensions.MathNet owns its version here, independently of the other
    packages (see docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md).

    0.1.0 is this package's first release. It carries one edge, to
    Lodestar.Abstractions, because CsrMatrix is the type it converts — so its
    floor moves when that package publishes API this one needs. It has moved
    once, from 0.1.1 to 0.2.0 with #1142.
  -->
  <PropertyGroup>
    <LodestarExtensionsMathNetVersion>0.1.1</LodestarExtensionsMathNetVersion>
  </PropertyGroup>

</Project>
