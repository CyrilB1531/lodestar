<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarTextVersion)</Version>

    <!-- Target framework (see docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md). -->
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Text</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- Pulls in the shared persistence plumbing (and System.Text.Json on ns2.0). -->
    <LodestarIncludesPersistence>true</LodestarIncludesPersistence>
    <LodestarIncludesMinHash>true</LodestarIncludesMinHash>

    <!-- NuGet package identity. System.Text.Json on netstandard2.0 is the single,
         deliberate runtime dependency (in-box on net10) — everything else in this
         package is dependency-free by design. -->
    <PackageId>Lodestar.Text</PackageId>
    <Description>String distances, similarity metrics, tokenizers and text vectorizers for .NET — native, allocation-lean, no Python at runtime.</Description>
    <PackageTags>text;similarity;levenshtein;distance;fuzzy;tfidf;nlp;lodestar</PackageTags>
  </PropertyGroup>

  <!-- CsrMatrix and SparseNorm live in Lodestar.Abstractions since 0.5.0, and since 0.7.0 so do the
       sixteen data types this package forwards there (decision 0003, #1142). PorterStemmerMode
       joined them (#1193), so this reaches that project unconditionally until the next
       Lodestar.Abstractions is on nuget.org; packing turns the reference into a dependency on that
       version. The release swaps it back for a PackageReference on the published floor and drops
       its exception in ci.yml's "src/ ships PackageReference only" step. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Text.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Text.NetStandard.Tests" />
  </ItemGroup>

</Project>
