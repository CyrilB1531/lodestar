<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarMetricsVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Metrics</RootNamespace>

    <PackageId>Lodestar.Metrics</PackageId>
    <Description>Classification metrics for .NET at exact scikit-learn parity: precision, recall, F1, FBeta, confusion matrix, classification report and ROC-AUC, with sklearn's averaging modes and zero-division semantics. No dependencies.</Description>
    <PackageTags>metrics;classification;f1;precision;recall;roc-auc;confusion-matrix;scikit-learn;lodestar</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lodestar.Metrics.Tests" />
    <!-- Same suite, replayed against the netstandard2.0 build. -->
    <InternalsVisibleTo Include="Lodestar.Metrics.NetStandard.Tests" />
  </ItemGroup>

  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). A
       ProjectReference, unconditionally, until Lodestar.Abstractions 0.2.0 is on nuget.org: the
       types leave this assembly in the same commit they arrive in that one, and packing turns
       the reference into a dependency on 0.2.0. The release swaps it for a PackageReference on
       the published floor and drops the exception in ci.yml's "src/ ships PackageReference
       only" step. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

</Project>
