<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarFuzzyVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Fuzzy</RootNamespace>
    <PackageId>Lodestar.Fuzzy</PackageId>
    <Description>Applied fuzzy string matching for .NET (rapidfuzz-compatible fuzz ratios, process.extract, dedup). No external dependencies.</Description>
    <PackageTags>fuzzy;matching;rapidfuzz;fuzzywuzzy;dedup;nlp;lodestar</PackageTags>
  </PropertyGroup>

  <!--
    Fuzz.Ratio is Indel.NormalizedSimilarity × 100, so the dependency on
    Lodestar.Text is real and permanent. What changed is how it is expressed: a
    PackageReference against the published package, so the build graph is the
    graph consumers see, and the two packages can release on their own cadences.

    The default — no property set — is the path CI packs and ships. The opt-in
    below exists only so that editing Lodestar.Text and Lodestar.Fuzzy in the same
    branch does not require a pack-and-restore cycle per edit:

        export LodestarUseProjectRefs=true

    MSBuild reads environment variables as properties, so that one export covers
    dotnet build, dotnet test and the IDE. It is never set in CI, and the packed
   .nuspec is asserted there — see docs/decisions/0001-the-foundations-target-frameworks-comparison-unit-persistence-and-versioning.md.
  -->
  <!-- The data types this package forwards to Lodestar.Abstractions (decision 0003, #1142). A
       ProjectReference, unconditionally, until Lodestar.Abstractions 0.2.0 is on nuget.org: the
       types leave this assembly in the same commit they arrive in that one, and packing turns
       the reference into a dependency on 0.2.0. The release swaps it for a PackageReference on
       the published floor and drops the exception in ci.yml's "src/ ships PackageReference
       only" step.

       Lodestar.Text is referenced the same way for the same wave: Fuzz names TextElement, which
       the published Lodestar.Text 0.6.0 declares and Lodestar.Abstractions 0.2.0 now does too, so
       the two together would be CS0433. The release restores the published floor, and the
       LodestarUseProjectRefs developer loop with it. -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
    <ProjectReference Include="../Lodestar.Text/Lodestar.Text.csproj" />
  </ItemGroup>

</Project>
