<Project Sdk="Microsoft.NET.Sdk">

  <!-- This package's version, owned here rather than repository-wide. -->
  <Import Project="Version.props" />

  <PropertyGroup>
    <Version>$(LodestarFuzzyVersion)</Version>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>Lodestar.Fuzzy</RootNamespace>
    <PackageId>Lodestar.Fuzzy</PackageId>
    <Description>Applied fuzzy string matching for .NET (rapidfuzz-compatible fuzz ratios, process.extract, dedup). No external dependencies.</Description>
    <PackageTags>fuzzy;matching;rapidfuzz;fuzzywuzzy;dedup;nlp;lodestar</PackageTags>
  </PropertyGroup>

  <!--
    Fuzz.Ratio is Indel.NormalizedSimilarity × 100, so the dependency on Lodestar.Text is real
    and permanent.


    Siblings by project until the packages are on nuget.org (#1739): pack turns each into a
    dependency on that project's declared version, which check_nuspec_dependencies.py asserts.
  -->
  <ItemGroup>
    <ProjectReference Include="../Lodestar.Text/Lodestar.Text.csproj" />
    <ProjectReference Include="../Lodestar.Abstractions/Lodestar.Abstractions.csproj" />
  </ItemGroup>

</Project>
